generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// مدل کاربران
model User {
  id            Int       @id @default(autoincrement())
  
  // فیلدهای اجباری
  name          String
  phone         String    @unique
  
  // فیلدهای اختیاری
  email         String?   @unique
  password      String?
  nationalCode  String?   @unique  @db.VarChar(10)
  avatar        String?
  birthDate     DateTime?
  gender        Gender?
  
  // وضعیت و نقش
  role          Role      @default(CUSTOMER)
  isActive      Boolean   @default(true)
  isVerified    Boolean   @default(false)
  lastLoginAt   DateTime?
  
  // زمان‌ها
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // روابط
  addresses     Address[]
  cart          Cart?
  orders        Order[]
}


// مدل آدرس‌ها (جدید)
model Address {
  id            Int       @id @default(autoincrement())
  
  userId        Int
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // عنوان آدرس (مثلاً "خانه"، "محل کار")
  title         String    @default("خانه")
  
  // اطلاعات گیرنده
  receiverName  String
  receiverPhone String
  
  // موقعیت مکانی
  province      String
  city          String
  postalCode    String?   @db.VarChar(10)
  fullAddress   String    @db.Text
  
  // مختصات جغرافیایی (اختیاری)
  latitude      Float?
  longitude     Float?
  
  // پرچم‌ها
  isDefault     Boolean   @default(false)
  isActive      Boolean   @default(true)
  
  // زمان‌ها
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // ایندکس برای جستجوی سریع‌تر
  @@index([userId])
  @@index([userId, isDefault])
}

// جنسیت
enum Gender {
  MALE
  FEMALE
  OTHER
}

// نقش کاربران
enum Role {
  CUSTOMER
  ADMIN
}

// مدل دسته‌بندی محصولات
model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  
  products    Product[]
}

// مدل محصولات
model Product {
  id          Int       @id @default(autoincrement())
  name        String
  description String?   @db.Text
  price       Decimal   @db.Decimal(10, 2)
  stock       Int       @default(0)
  imageUrl    String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  categoryId  Int?
  category    Category? @relation(fields: [categoryId], references: [id])
  
  cartItems   CartItem[]
  orderItems  OrderItem[]
}

// مدل سبد خرید
model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

// آیتم‌های سبد خرید
model CartItem {
  id        Int      @id @default(autoincrement())
  quantity  Int      @default(1)
  cartId    Int
  productId Int
  
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])
  
  @@unique([cartId, productId])
}

// مدل سفارشات
model Order {
  id          Int         @id @default(autoincrement())
  userId      Int
  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @db.Decimal(10, 2)
  address     String?     @db.Text
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  user        User        @relation(fields: [userId], references: [id])
  items       OrderItem[]
}

// وضعیت سفارش
enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

// آیتم‌های سفارش
model OrderItem {
  id        Int     @id @default(autoincrement())
  quantity  Int
  price     Decimal @db.Decimal(10, 2) // قیمت در لحظه خرید
  orderId   Int
  productId Int
  
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}